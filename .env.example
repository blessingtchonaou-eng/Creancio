# Base PostgreSQL
DATABASE_URL="postgresql://creancio_dev:motdepasse@localhost:5432/creancio_dev"

# PayGate Global (https://paygateglobal.com)
PAYGATE_API_KEY=""

# WhatsApp Cloud API (via votre BSP)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Better Auth : générer le secret avec  openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# E-mails (mot de passe oublié, confirmation d'adresse)
# Développement : "console" (l'e-mail s'affiche dans le terminal) ou "mailpit" (boîte locale http://localhost:8025,
# docker compose up -d mailpit). Aucun e-mail ne part pour de vrai hors production.
# Production : "resend" (ou "brevo") ; le serveur refuse de démarrer sans clé ni adresse d'expédition.
EMAIL_DRIVER="console"
EMAIL_FROM="Créancio <ne-pas-repondre@creancio.local>"
RESEND_API_KEY=""
BREVO_API_KEY=""
MAILPIT_URL="http://localhost:8025"

# Administration de la plateforme (/admin) : adresses de l'équipe Créancio, séparées par des virgules.
# L'adresse doit aussi être confirmée. Vide = personne n'a accès.
ADMIN_PLATEFORME_EMAILS=""

# Adresse IP du visiteur (limite de débit). Obligatoire en production : le serveur refuse de démarrer sans elles.
# CLIENT_IP_HEADER : l'en-tête que le proxy inverse (nginx, Caddy, Vercel…) renseigne avec l'adresse du visiteur.
# TRUSTED_PROXY_COUNT : nombre de proxys de confiance devant l'application (1 pour un seul nginx/Caddy ou pour Vercel).
# Le proxy doit ajouter l'adresse qu'il voit à x-forwarded-for, jamais laisser passer l'en-tête du visiteur tel quel.
# Ignoré en développement (x-forwarded-for, 1 proxy, 127.0.0.1 sans en-tête).
CLIENT_IP_HEADER=""
TRUSTED_PROXY_COUNT=""

# Inscription publique. false (ou absente) pendant le pilote : /inscription n'accepte alors qu'un lien d'invitation
# à usage unique, créé depuis /admin/pilote (voir src/lib/invitation-pilote.ts). Repasser à "true" à la fin du pilote.
INSCRIPTIONS_OUVERTES="false"
