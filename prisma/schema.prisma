// Modèle de données Créancio — issu du cahier des charges (section 5)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COLLABORATEUR
}

enum StatutFacture {
  A_VENIR
  ECHUE
  EN_RELANCE
  PARTIELLEMENT_PAYEE
  PAYEE
  SUSPENDUE
  ANNULEE
}

enum Operateur {
  FLOOZ
  MIXX
  ESPECES
  VIREMENT
}

enum Canal {
  WHATSAPP
  SMS
}

enum StatutRelance {
  PLANIFIEE
  ENVOYEE
  LUE
  ECHEC
  ANNULEE
}

model Entreprise {
  id            String     @id @default(cuid())
  raisonSociale String
  nif           String?
  telephone     String?
  logoUrl       String?
  signature     String?
  // Prochaine étape de l'onboarding : 2 = premier client, 3 = premières factures, 4 = terminé.
  etapeOnboarding Int      @default(2)
  createdAt     DateTime   @default(now())
  utilisateurs  Utilisateur[]
  clients       Client[]
  factures      Facture[]
  scenarios     ScenarioRelance[]
}

// Utilisateur, Session, Compte et Verification sont les tables de Better Auth.
// entrepriseId reste vide tant que l'onboarding (étape 1) n'est pas terminé.
model Utilisateur {
  id            String      @id @default(cuid())
  entrepriseId  String?
  entreprise    Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: SetNull)
  nom           String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  role          Role        @default(COLLABORATEUR)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  comptes       Compte[]
  paiementsAnnules Paiement[]

  @@index([entrepriseId])
}

model Session {
  id        String      @id @default(cuid())
  userId    String
  user      Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String      @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

// Le mot de passe haché (scrypt) est stocké ici, jamais en clair.
model Compte {
  id                    String      @id @default(cuid())
  userId                String
  user                  Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Client {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  nom          String
  whatsapp     String // format E.164, ex. +22890123456
  email        String?
  relancesEnPause Boolean @default(false)
  createdAt    DateTime   @default(now())
  factures     Facture[]

  // Index simple, pas d'unicité : un même numéro peut servir à plusieurs clients (boutique et gérant, famille).
  @@index([entrepriseId, whatsapp])
}

model Facture {
  id              String           @id @default(cuid())
  entrepriseId    String
  entreprise      Entreprise       @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id])
  scenarioId      String?
  scenario        ScenarioRelance? @relation(fields: [scenarioId], references: [id])
  numero          String
  montant         Int // FCFA, entier
  montantPaye     Int              @default(0)
  dateFacture     DateTime         @default(now()) @db.Date // date d’émission : base du délai moyen de paiement
  // Vrai quand la date d'émission n'était pas dans le fichier importé (on a mis la date d'import) : exclue du délai moyen de paiement.
  dateFactureEstimee Boolean       @default(false)
  echeance        DateTime         @db.Date
  statut          StatutFacture    @default(A_VENIR)
  lienPaiement    String?
  createdAt       DateTime         @default(now())
  paiements       Paiement[]
  relances        Relance[]

  @@unique([entrepriseId, numero]) // numérotation OTR sans doublon
  @@index([entrepriseId, statut])
}

model Paiement {
  id          String    @id @default(cuid())
  factureId   String
  facture     Facture   @relation(fields: [factureId], references: [id], onDelete: Cascade)
  montant     Int
  operateur   Operateur
  referenceTx String    @unique // référence PayGate : empêche un double traitement (paiement manuel : MANUEL-<identifiant du formulaire>)
  payeLe      DateTime
  createdAt   DateTime  @default(now())
  // Paiement saisi à la main (espèces, virement, Mobile Money hors PayGate) : seul celui-là peut être annulé depuis l'interface.
  manuel      Boolean   @default(false)
  reference   String? // référence saisie à la main, facultative
  // On n'efface jamais un paiement : on l'annule en gardant la trace (qui, quand, pourquoi).
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation(fields: [annuleParId], references: [id], onDelete: SetNull)
  motifAnnulation String? // 3 à 200 caractères, contrôlé par le code

  @@index([annuleParId])
}

model ScenarioRelance {
  id           String         @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise     @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  nom          String
  parDefaut    Boolean        @default(false)
  etapes       EtapeRelance[]
  factures     Facture[]
}

model EtapeRelance {
  id          String          @id @default(cuid())
  scenarioId  String
  scenario    ScenarioRelance @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  decalage    Int // jours par rapport à l'échéance : -3, 0, 7, 15
  titre       String
  canal       Canal           @default(WHATSAPP)
  templateId  String // nom du template WhatsApp validé par Meta
  repliSms    Boolean         @default(true)
}

model Relance {
  id          String        @id @default(cuid())
  factureId   String
  facture     Facture       @relation(fields: [factureId], references: [id], onDelete: Cascade)
  decalage    Int
  canal       Canal
  statut      StatutRelance @default(PLANIFIEE)
  prevueLe    DateTime
  envoyeeLe   DateTime?
  lueLe       DateTime?
  erreur      String?

  @@unique([factureId, decalage, canal]) // aucun double envoi
  @@index([statut, prevueLe])
}

model EvenementWebhook {
  id         String   @id @default(cuid())
  source     String // "paygate" | "whatsapp"
  reference  String
  payload    Json
  traite     Boolean  @default(false)
  recuLe     DateTime @default(now())

  @@unique([source, reference])
}
